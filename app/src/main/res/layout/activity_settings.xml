<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- rozcestník – položky doplní kód -->
        <LinearLayout android:id="@+id/sec_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <LinearLayout android:id="@+id/sec_keys" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Section" android:textSize="22sp" android:text="🔑 Klíče a přístupy" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/send_cfg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📲 Poslat do TV" />
            <Button android:id="@+id/recv_cfg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="📺 Načíst z telefonu" />
        </LinearLayout>
        <TextView style="@style/Label" android:text="Přenese klíče a nastavení z telefonu do boxu přes domácí Wi-Fi (oba musí být ve stejné síti)." />

        <TextView style="@style/Label" android:textStyle="bold" android:textColor="#333333" android:text="Tuya Cloud – data ze stanice (povinné)" />
        <TextView style="@style/Label" android:autoLink="web" android:text="Cloud projekt na iot.tuya.com → Overview (Access ID/Secret), Devices (Device ID): https://iot.tuya.com" />
        <TextView style="@style/Label" android:text="Access ID / Client ID" />
        <EditText android:id="@+id/access_id" style="@style/Field" android:inputType="text" />
        <TextView style="@style/Label" android:text="Access Secret / Client Secret" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/access_secret" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:hint="" android:inputType="textPassword" />
            <TextView android:id="@+id/eye_secret" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="👁" android:textSize="18sp" />
        </LinearLayout>
        <TextView style="@style/Label" android:text="Device ID stanice" />
        <EditText android:id="@+id/device_id" style="@style/Field" android:inputType="text" />
        <TextView style="@style/Label" android:text="Datové centrum" />
        <Spinner android:id="@+id/data_center" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/st_tuya" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />

        <TextView style="@style/Label" android:layout_marginTop="16dp" android:textStyle="bold" android:textColor="#333333" android:text="Mapy.com – satelitní mapa na radaru" />
        <TextView style="@style/Label" android:autoLink="web" android:text="Registrace a projekt s API klíčem: https://developer.mapy.com/account" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/mapy_key" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:hint="API klíč Mapy.com" android:inputType="textPassword" />
            <TextView android:id="@+id/eye_mapy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="👁" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:id="@+id/st_mapy" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />

        <TextView style="@style/Label" android:layout_marginTop="16dp" android:textStyle="bold" android:textColor="#333333" android:text="OpenWeatherMap – vrstvy oblačnost, teplota, vítr (nepovinné)" />
        <TextView style="@style/Label" android:autoLink="web" android:text="Účet zdarma, klíč v sekci My API keys: https://home.openweathermap.org/api_keys" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/owm_key" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:hint="API klíč OpenWeatherMap" android:inputType="textPassword" />
            <TextView android:id="@+id/eye_owm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="👁" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:id="@+id/st_owm" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />

        <TextView style="@style/Label" android:layout_marginTop="16dp" android:textStyle="bold" android:textColor="#333333" android:text="Kalendář – dnešní události na TV" />
        <TextView style="@style/Label" android:text="Google Kalendář (web) → Nastavení → vyber kalendář → Integrace kalendáře → Tajná adresa ve formátu iCal. Adresu zkopíruj sem." />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/ics_url" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:hint="https://calendar.google.com/…/basic.ics" android:inputType="textPassword" />
            <TextView android:id="@+id/eye_ics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="👁" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:id="@+id/st_ics" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />
        <TextView style="@style/Label" android:text="Název hlavního kalendáře (žlutá) a další kalendáře pro kartu Kalendář na TV – např. Beátka, svoz odpadu, školní prázdniny" />
        <EditText android:id="@+id/ics_name0" style="@style/Field" android:hint="Můj kalendář" android:inputType="textCapSentences" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/ics_name1" style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:hint="Název (modrá)" android:inputType="textCapSentences" />
            <EditText android:id="@+id/ics_url1" style="@style/Field" android:layout_width="0dp" android:layout_weight="2" android:hint="iCal adresa" android:inputType="textUri" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/ics_name2" style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:hint="Název (zelená)" android:inputType="textCapSentences" />
            <EditText android:id="@+id/ics_url2" style="@style/Field" android:layout_width="0dp" android:layout_weight="2" android:hint="iCal adresa" android:inputType="textUri" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/ics_name3" style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:hint="Název (růžová)" android:inputType="textCapSentences" />
            <EditText android:id="@+id/ics_url3" style="@style/Field" android:layout_width="0dp" android:layout_weight="2" android:hint="iCal adresa" android:inputType="textUri" android:singleLine="true" />
        </LinearLayout>

        <TextView style="@style/Label" android:layout_marginTop="16dp" android:textStyle="bold" android:textColor="#333333" android:text="Google Weather API – volitelný zdroj předpovědi pro widget" />
        <TextView style="@style/Label" android:autoLink="web" android:text="Google Cloud projekt s Weather API: https://developers.google.com/maps/documentation/weather" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/google_key" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:hint="API klíč Google" android:inputType="textPassword" />
            <TextView android:id="@+id/eye_google" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="👁" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:id="@+id/st_google" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/sec_station" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Section" android:textSize="22sp" android:text="📟 Stanice a čidla" />
        <TextView style="@style/Section" android:text="Názvy kanálů" />

        <TextView style="@style/Label" android:text="Hlavní stanice (vnitřní)" />
        <EditText android:id="@+id/name_in" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="Venkovní čidlo (velké číslo)" />
        <EditText android:id="@+id/name_out" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="Čidlo 1" />
        <EditText android:id="@+id/name_s1" style="@style/Field" android:inputType="text" />
        <CheckBox android:id="@+id/indoor_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vnitřní čidlo (zobrazit komfortní zónu)" />

        <TextView style="@style/Label" android:text="Čidlo 2" />
        <EditText android:id="@+id/name_s2" style="@style/Field" android:inputType="text" />
        <CheckBox android:id="@+id/indoor_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vnitřní čidlo (zobrazit komfortní zónu)" />

        <TextView style="@style/Label" android:text="Čidlo 3" />
        <EditText android:id="@+id/name_s3" style="@style/Field" android:inputType="text" />
        <CheckBox android:id="@+id/indoor_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vnitřní čidlo (zobrazit komfortní zónu)" />

        <TextView style="@style/Section" android:text="Komfortní zóna (doma a vnitřní čidla)" />

        <CheckBox android:id="@+id/n_hum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hlídat vlhkost doma (upozornění + pásmo v grafu)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Label" android:text="Minimum (%)" />
                <EditText android:id="@+id/n_hum_min" style="@style/Field" android:inputType="number" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Label" android:text="Maximum (%)" />
                <EditText android:id="@+id/n_hum_max" style="@style/Field" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Label" android:layout_marginTop="10dp" android:text="Komfortní zóna teploty doma (°C)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Label" android:text="Minimum (°C)" />
                <EditText android:id="@+id/comf_t_min" style="@style/Field" android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Label" android:text="Maximum (°C)" />
                <EditText android:id="@+id/comf_t_max" style="@style/Field" android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>
        <LinearLayout android:id="@+id/sec_forecast" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Section" android:textSize="22sp" android:text="📅 Předpověď a místo" />
        <TextView style="@style/Section" android:text="Předpověď na 10 dní" />

        <TextView style="@style/Label" android:text="Zdroj" />
        <Spinner
            android:id="@+id/fc_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <TextView style="@style/Label" android:text="Místo" />
        <EditText android:id="@+id/loc_name" style="@style/Field" android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Zeměpisná šířka" />
                <EditText
                    android:id="@+id/loc_lat"
                    style="@style/Field"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Zeměpisná délka" />
                <EditText
                    android:id="@+id/loc_lon"
                    style="@style/Field"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Section" android:text="Výstrahy ČHMÚ" />
        <TextView style="@style/Label" android:text="Oblast výstrah (název ORP nebo okresu, např. Kyjov)" />
        <EditText android:id="@+id/alert_region" style="@style/Field" android:inputType="text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/sec_notify" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Section" android:textSize="22sp" android:text="🔔 Upozornění" />

        <CheckBox android:id="@+id/n_frost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mráz – teplota venku pod (°C):" />
        <EditText android:id="@+id/n_frost_lim" style="@style/Field" android:inputType="numberDecimal|numberSigned" />

        <CheckBox android:id="@+id/n_rain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Začátek deště (podle stanice)" />

        <CheckBox android:id="@+id/n_wind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Silný vítr – nárazy od (km/h):" />
        <EditText android:id="@+id/n_wind_lim" style="@style/Field" android:inputType="numberDecimal" />

        <CheckBox android:id="@+id/n_pres" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Rychlý pokles tlaku – za 3 h o (hPa):" />
        <EditText android:id="@+id/n_pres_lim" style="@style/Field" android:inputType="numberDecimal" />

        <CheckBox android:id="@+id/n_uv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Vysoké UV – index od:" />
        <EditText android:id="@+id/n_uv_lim" style="@style/Field" android:inputType="numberDecimal" />

        <CheckBox android:id="@+id/n_alerts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Výstrahy ČHMÚ" />

        </LinearLayout>
        <LinearLayout android:id="@+id/sec_tv" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Section" android:textSize="22sp" android:text="📺 Televize" />
        <TextView style="@style/Section" android:text="Televize – plánované spuštění" />

        <CheckBox android:id="@+id/tv_start_on" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Každý den spustit panel v (HH:MM):" />
        <EditText android:id="@+id/tv_start_time" style="@style/Field" android:inputType="time" />
        <CheckBox android:id="@+id/tv_stop_on" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Každý den zavřít panel v (HH:MM):" />
        <EditText android:id="@+id/tv_stop_time" style="@style/Field" android:inputType="time" />
        <CheckBox android:id="@+id/tv_workdays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Mimo víkendy a svátky (spouštět jen v pracovní dny)" />
        <TextView android:id="@+id/tv_next_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#666666" />
        <TextView style="@style/Label" android:text="Automaticky zavřít panel po spuštění budíkem (minut, 0 = nezavírat). Stisk ovladače zavření zruší." />
        <EditText android:id="@+id/tv_autoclose" style="@style/Field" android:inputType="number" android:maxLength="4" />
        <TextView style="@style/Label" android:text="Vrátit se na kartu Dnes po nečinnosti" />
        <Spinner android:id="@+id/tv_idle_return" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/tv_sleep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Po automatickém zavření uspat box (vypne i televizi přes HDMI-CEC)" />
        <TextView android:id="@+id/tv_sleep_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#666666" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#666666" android:text="V Usnadnění sjeď dolů do části Služby → Meteostanice – uspání → zapnout." />
        <Button android:id="@+id/tv_sleep_a11y_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Povolit uspání přes Usnadnění" />
        <Button android:id="@+id/tv_sleep_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Povolit přes Správu zařízení (záloha)" />
        <Button android:id="@+id/tv_autoclose_test" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Otestovat automatické vypnutí (za 1 minutu)" />
        <CheckBox android:id="@+id/tv_boot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Spustit panel po zapnutí boxu" />
        <TextView android:id="@+id/tv_overlay_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/tv_overlay_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Povolit spouštění" />
            <Button android:id="@+id/tv_test_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Vyzkoušet za 2 minuty" />
        </LinearLayout>
        <TextView style="@style/Label" android:text="Televizi zapne box přes HDMI-CEC – na Samsungu zapni Anynet+ (HDMI-CEC), na boxu ovládání HDMI-CEC." />

        <TextView style="@style/Section" android:text="Televize – jas a noční režim" />

        <TextView
            android:id="@+id/tv_day_label"
            style="@style/Label"
            android:text="Jas ve dne" />
        <SeekBar
            android:id="@+id/tv_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <CheckBox
            android:id="@+id/tv_anim_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Animované ikony předpovědi (v noci vypnuté)" />

        <CheckBox
            android:id="@+id/tv_night_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Noční režim" />

        <TextView
            android:id="@+id/tv_night_label"
            style="@style/Label"
            android:text="Jas v noci" />
        <SeekBar
            android:id="@+id/tv_night"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Noc od (hodina)" />
                <EditText
                    android:id="@+id/tv_night_from"
                    style="@style/Field"
                    android:inputType="number"
                    android:maxLength="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Noc do (hodina)" />
                <EditText
                    android:id="@+id/tv_night_to"
                    style="@style/Field"
                    android:inputType="number"
                    android:maxLength="2" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:text="Na panelu v televizi mění jas i šipky nahoru/dolů. OK = nastavení, šipka doprava = obnovit." />

        <!-- ranní režim – doplní kód -->
        <LinearLayout android:id="@+id/tv_morning_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/Section" android:text="Televize – pozdrav a upozornění" />
        <TextView style="@style/Label" android:text="Na kartě Dnes je vpravo pozdrav podle denní doby, kalendář a na co si dát pozor. Ve 20:00 se kalendář i upozornění přepnou na zítřek." />
        <TextView style="@style/Label" android:text="Oslovení (aplikace doplní „Dobré ráno, …“)" />
        <EditText android:id="@+id/tm_names" style="@style/Field" android:inputType="textCapWords" />
        <TextView style="@style/Label" android:text="Prahy upozornění" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView style="@style/Label" android:text="Mráz pod (°C)" />
                <EditText android:id="@+id/tm_frost" style="@style/Field" android:inputType="numberSigned|numberDecimal" android:maxLength="5" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView style="@style/Label" android:text="Vítr od (km/h)" />
                <EditText android:id="@+id/tm_wind" style="@style/Field" android:inputType="number" android:maxLength="3" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView style="@style/Label" android:text="Déšť od (mm)" />
                <EditText android:id="@+id/tm_rain_mm" style="@style/Field" android:inputType="numberDecimal" android:maxLength="4" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView style="@style/Label" android:text="nebo pravděp. od (%)" />
                <EditText android:id="@+id/tm_rain_pct" style="@style/Field" android:inputType="number" android:maxLength="3" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Label" android:text="Výrazná změna teploty proti předchozímu dni (dny v 10denní předpovědi pulzují)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView style="@style/Label" android:text="Oteplení o (°C)" />
                <EditText android:id="@+id/tm_warm" style="@style/Field" android:inputType="numberDecimal" android:maxLength="4" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView style="@style/Label" android:text="Ochlazení o (°C)" />
                <EditText android:id="@+id/tm_cool" style="@style/Field" android:inputType="numberDecimal" android:maxLength="4" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/sec_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Section" android:textSize="22sp" android:text="🗄 Data a historie" />
        <TextView style="@style/Section" android:text="Historie" />
        <TextView
            android:id="@+id/battery_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
        <Button
            android:id="@+id/battery_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nastavení baterie aplikace" />
        <Button
            android:id="@+id/backfill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Znovu doplnit historii z Tuya (7 dní)" />
        <TextView
            android:id="@+id/backfill_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        </LinearLayout>
        <LinearLayout android:id="@+id/sec_app" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Section" android:textSize="22sp" android:text="ℹ Aplikace" />
        <!-- Aktualizace -->
        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <Button
            android:id="@+id/update_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zkontrolovat aktualizace" />

        </LinearLayout>
        <LinearLayout android:id="@+id/sec_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Uložit a otestovat" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
