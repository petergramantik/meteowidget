<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Aktualizace -->
        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <Button
            android:id="@+id/update_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zkontrolovat aktualizace" />

        <TextView style="@style/Section" android:text="Stanice (Tuya Cloud)" />

        <TextView style="@style/Label" android:text="Access ID / Client ID" />
        <EditText android:id="@+id/access_id" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="Access Secret / Client Secret" />
        <EditText android:id="@+id/access_secret" style="@style/Field" android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="Device ID stanice" />
        <EditText android:id="@+id/device_id" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="Datové centrum" />
        <Spinner
            android:id="@+id/data_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/Section" android:text="Názvy kanálů" />

        <TextView style="@style/Label" android:text="Hlavní stanice (vnitřní)" />
        <EditText android:id="@+id/name_in" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="Venkovní čidlo (velké číslo)" />
        <EditText android:id="@+id/name_out" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="Čidlo 1" />
        <EditText android:id="@+id/name_s1" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="Čidlo 2" />
        <EditText android:id="@+id/name_s2" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="Čidlo 3" />
        <EditText android:id="@+id/name_s3" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Section" android:text="Předpověď na 10 dní" />

        <TextView style="@style/Label" android:text="Zdroj" />
        <Spinner
            android:id="@+id/fc_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/google_key_label"
            style="@style/Label"
            android:text="Google Maps Platform API klíč (Weather API)" />
        <EditText android:id="@+id/google_key" style="@style/Field" android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="Místo" />
        <EditText android:id="@+id/loc_name" style="@style/Field" android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Zeměpisná šířka" />
                <EditText
                    android:id="@+id/loc_lat"
                    style="@style/Field"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Zeměpisná délka" />
                <EditText
                    android:id="@+id/loc_lon"
                    style="@style/Field"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Section" android:text="Televize – jas a noční režim" />

        <TextView
            android:id="@+id/tv_day_label"
            style="@style/Label"
            android:text="Jas ve dne" />
        <SeekBar
            android:id="@+id/tv_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <CheckBox
            android:id="@+id/tv_night_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Noční režim" />

        <TextView
            android:id="@+id/tv_night_label"
            style="@style/Label"
            android:text="Jas v noci" />
        <SeekBar
            android:id="@+id/tv_night"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Noc od (hodina)" />
                <EditText
                    android:id="@+id/tv_night_from"
                    style="@style/Field"
                    android:inputType="number"
                    android:maxLength="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Noc do (hodina)" />
                <EditText
                    android:id="@+id/tv_night_to"
                    style="@style/Field"
                    android:inputType="number"
                    android:maxLength="2" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:text="Na panelu v televizi mění jas i šipky nahoru/dolů. OK = nastavení, šipka doprava = obnovit." />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Uložit a otestovat" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
